# Copie para .env.local e preencha (Supabase > Project Settings > API).
# Use SOMENTE a chave anon/publishable. Nunca a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Keycloak local iniciado por docker compose (veja docs/KEYCLOAK_SETUP.md).
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=caderno-inteligente
VITE_KEYCLOAK_CLIENT_ID=caderno-inteligente
